# ANDESDB LMS pilot
# Copiar a .env.local fuera del repositorio.
# Nunca poner service_role, sb_secret_*, password de BD, JWT secret,
# SMTP password ni OAuth client secret aquí.

ANDESDB_LMS_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
ANDESDB_LMS_ORIGIN=https://YOUR_LMS_HOST
ANDESDB_LAB_ORIGIN=https://YOUR_SEPARATE_LAB_HOST

# LMS_ORIGIN y LAB_ORIGIN deben ser HTTPS y diferentes.
# Solo para tooling local; NO son credenciales del proveedor.
ANDESDB_ACTIVITY_ID=s7-restaurante-abc
ANDESDB_ACTIVITY_VERSION=1
