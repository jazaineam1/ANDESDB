# ANDESDB LMS pilot
# Copiar a .env.local fuera del repositorio.
# Nunca poner service_role, JWT secret, SMTP password ni OAuth client secret aquí.

ANDESDB_LMS_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Solo para tooling local; NO es una credencial del proveedor.
ANDESDB_ACTIVITY_ID=s7-restaurante-abc
ANDESDB_ACTIVITY_VERSION=1
