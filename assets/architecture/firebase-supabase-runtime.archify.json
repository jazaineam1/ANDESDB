  "cards": [
    {
      "dot": "cyan",
      "title": "Lo que una clave pública sí hace",
      "items": [
        "Indica a qué proyecto se dirige una llamada.",
        "Permite que el SDK o la Data API reconozcan el cliente público.",
        "No equivale a contraseña ni a permiso de administrador."
      ]
    },
    {
      "dot": "emerald",
      "title": "Las dos bases no se conectan entre sí",
      "items": [
        "El navegador lee el carrito desde Firestore.",
        "El mismo navegador pide a Supabase confirmar la compra.",
        "Solo la venta confirmada vive en PostgreSQL."
      ]
    },
    {
      "dot": "rose",
      "title": "Límites obligatorios",
      "items": [
        "Firebase Auth + Firestore Rules protegen cada carrito.",
        "RLS, revocaciones y GRANT EXECUTE limitan Supabase.",
        "Nunca se expone service role, secret key ni contraseña de la base."
      ]
    }
  ]
